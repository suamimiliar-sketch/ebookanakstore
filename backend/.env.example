# ─── App ─────────────────────────────────────────────
APP_NAME=ebookanakstore-api
APP_ENV=development
APP_VERSION=2.0.0
LOG_LEVEL=INFO

# ─── Database ────────────────────────────────────────
# Postgres (production)
DATABASE_URL=postgresql+psycopg://ebook:ebook@localhost:5432/ebookanakstore
# SQLite fallback (local dev, works without Postgres)
# DATABASE_URL=sqlite:///./ebookanakstore.db

# ─── Auth ────────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32
JWT_ALG=HS256
JWT_TTL_MINUTES=480
ADMIN_BOOTSTRAP_EMAIL=admin@ebookanak.store
ADMIN_BOOTSTRAP_PASSWORD=change-me

# ─── CORS ────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,https://ebookanak.store,https://www.ebookanak.store

# ─── Midtrans ────────────────────────────────────────
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# ─── Cloudinary ──────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Notification (optional) ─────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_FROM=noreply@ebookanak.store
